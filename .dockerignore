# Files/folders excluded from the Docker build context (the tar `./` sent to the
# daemon). Keeping this small makes builds faster and avoids copying secrets into
# a layer. The `docker build` uses these to run `next build`; runtime config like
# .env is injected by docker-compose, not baked into the image.

# Dependencies + build output — rebuilt inside the container, never copied over.
node_modules
.next

# Version control + secrets
.git
.env*
*.tsbuildinfo
next-env.d.ts

# Local container files that don't belong in the image
Dockerfile
.dockerignore
docker-compose.yml

# Docs / SQL that aren't needed to run the app
README.md
AGENTS.md
CLAUDE.md
init_db.sql
