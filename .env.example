# PostgreSQL connection string used by the API (src/lib/db.ts).
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://postgres:password@localhost:5432/linkedin_games

# Set to true to require an SSL connection (e.g. most managed Postgres hosts).
DB_SSL=false

# Shared-secret bearer token required by POST /api/ingest (Authorization: Bearer <token>).
# The ingest route is a write path exposed to a small set of trusted scrapers, so
# it must be configured or no requests are accepted (fail-closed). Set the SAME
# value in the collectors' LEADERBOARD_API_TOKEN. Keep it secret; never expose to the browser.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LEADERBOARD_INGEST_TOKEN=
